# ─── List ────────────────────────────────────────────────────────
list_all() {
  echo -e "${BOLD}Available Loaders:${NC}"
  for f in "$LOADERS_DIR"/*.sh; do
    if [ -f "$f" ]; then
      NAME=$(basename "$f" .sh)
      DESC=$(head -3 "$f" | grep "^# bang-framework:" | sed 's/# bang-framework: //' || echo "")
      printf "  ${GREEN}%-20s${NC} %s\n" "$NAME" "$DESC"
    fi
  done

  echo ""
  echo -e "${BOLD}Available Profiles:${NC}"
  for f in "$PROFILES_DIR"/*.sh; do
    if [ -f "$f" ]; then
      NAME=$(basename "$f" .sh)
      DESC=$(head -3 "$f" | grep "^# bang-framework profile:" | sed 's/# bang-framework profile: //' || echo "")
      printf "  ${CYAN}%-20s${NC} %s\n" "$NAME" "$DESC"
    fi
  done
}

# ─── Compose ─────────────────────────────────────────────────────
compose_loaders() {
  local loaders=("$@")
  if [ ${#loaders[@]} -eq 0 ]; then
    echo -e "${RED}Error: compose requires at least one loader name${NC}" >&2
    echo "Usage: bang compose git-context test-status env-summary" >&2
    exit 1
  fi

  for loader in "${loaders[@]}"; do
    LOADER_PATH="$LOADERS_DIR/${loader}.sh"
    if [ -f "$LOADER_PATH" ]; then
      "$LOADER_PATH"
      echo ""
    else
      echo -e "${YELLOW}Warning: loader '${loader}' not found, skipping${NC}" >&2
    fi
  done
}

# ─── Hook Config Generator ──────────────────────────────────────
generate_hook_config() {
  local event="${1:-UserPromptSubmit}"
  local profile="${2:-dev}"
  local hook_type="command"

  # Parse --type flag
  local args=("$@")
  for i in "${!args[@]}"; do
    if [ "${args[$i]}" = "--type" ] && [ $((i+1)) -lt ${#args[@]} ]; then
      hook_type="${args[$((i+1))]}"
      # Remove --type and its value from positional args
      if [ $i -eq 0 ]; then event="${args[2]:-UserPromptSubmit}"; fi
    fi
  done

  # Validate hook type (3 types from RE analysis)
  local valid_types="command prompt agent"
  if ! echo "$valid_types" | grep -qw "$hook_type"; then
    echo -e "${RED}Error: invalid hook type '${hook_type}'${NC}" >&2
    echo "Valid types: ${valid_types}" >&2
    echo "  command — run a shell command, output becomes context" >&2
    echo "  prompt  — LLM prompt with template variables" >&2
    echo "  agent   — spawn an agent with template variables" >&2
    exit 1
  fi

  # Validate event name (all 7 events from RE analysis of Claude Code v2.1.71)
  local valid_events="UserPromptSubmit SessionStart SubagentStart PreToolUse PostToolUse PreCompact Stop"
  if ! echo "$valid_events" | grep -qw "$event"; then
    echo -e "${RED}Error: invalid hook event '${event}'${NC}" >&2
    echo "Valid events: ${valid_events}" >&2
    exit 1
  fi

  # Check if profile or loader
  if [ -f "$PROFILES_DIR/${profile}.sh" ]; then
    CMD="$BANG_DIR/profiles/${profile}.sh"
  elif [ -f "$LOADERS_DIR/${profile}.sh" ]; then
    CMD="$BANG_DIR/loaders/${profile}.sh"
  else
    echo -e "${RED}Error: '${profile}' is not a valid profile or loader${NC}" >&2
    exit 1
  fi

  # Generate JSON based on hook type (RE: 3 types — command, prompt, agent)
  case "$hook_type" in
    command)
      cat <<ENDJSON
{
  "hooks": [
    {
      "type": "command",
      "command": "${CMD}",
      "statusMessage": "bang: loading ${profile} context",
      "timeout": 30
    }
  ]
}
ENDJSON
      ;;
    prompt)
      cat <<ENDJSON
{
  "hooks": [
    {
      "type": "prompt",
      "prompt": "Process the output of ${profile} context loader and summarize the key points. Available variables: {{sessionMemory}}, {{userMessages}}, {{docContents}}",
      "statusMessage": "bang: AI-processing ${profile} context"
    }
  ]
}
ENDJSON
      ;;
    agent)
      cat <<ENDJSON
{
  "hooks": [
    {
      "type": "agent",
      "prompt": "Analyze the ${profile} context and provide actionable recommendations. Variables: {{sessionMemory}}, {{userMessages}}, {{customInstructions}}",
      "statusMessage": "bang: agent analyzing ${profile} context"
    }
  ]
}
ENDJSON
      ;;
  esac

  echo "" >&2
  echo -e "${GREEN}Add this to your settings.json under hooks.${event}[]${NC}" >&2
  echo -e "Or use: ${CYAN}bang install-hook ${event} ${profile}${NC}" >&2
}

# ─── Install Hook ────────────────────────────────────────────────
install_hook() {
  local event="${1:-}"
  local profile="${2:-}"

  if [ -z "$event" ] || [ -z "$profile" ]; then
    echo -e "${RED}Usage: bang install-hook <event> <profile|loader>${NC}" >&2
    echo "Example: bang install-hook UserPromptSubmit dev" >&2
    exit 1
  fi

  # Determine command path
  local cmd=""
  if [ -f "$PROFILES_DIR/${profile}.sh" ]; then
    cmd="$BANG_DIR/profiles/${profile}.sh"
  elif [ -f "$LOADERS_DIR/${profile}.sh" ]; then
    cmd="$BANG_DIR/loaders/${profile}.sh"
  else
    echo -e "${RED}Error: '${profile}' not found${NC}" >&2
    exit 1
  fi

  local settings_file="$HOME/.claude/settings.json"
  if [ ! -f "$settings_file" ]; then
    echo -e "${RED}Error: settings.json not found at ${settings_file}${NC}" >&2
    exit 1
  fi

  # Use jq to safely modify JSON (with python3 fallback)
  if command -v jq &>/dev/null; then
    # Check if already installed
    local already_installed
    already_installed=$(jq --arg event "$event" --arg cmd "$cmd" '
      .hooks[$event] // [] |
      map(.hooks // [] | map(select(.command == $cmd))) |
      flatten |
      length > 0
    ' "$settings_file")

    if [ "$already_installed" = "true" ]; then
      echo -e "${YELLOW}Hook already installed for ${event} → ${profile}${NC}"
      return 0
    fi

    # Add the hook using jq
    jq --arg event "$event" \
       --arg cmd "$cmd" \
       --arg profile "$profile" '
      .hooks[$event] += [{
        "hooks": [{
          "type": "command",
          "command": $cmd,
          "statusMessage": ("bang: loading " + $profile + " context"),
          "timeout": 30
        }]
      }]
    ' "$settings_file" > "${settings_file}.tmp" && mv "${settings_file}.tmp" "$settings_file"
  else
    # Python3 fallback
    python3 -c "
import json, sys

with open('$settings_file') as f:
    settings = json.load(f)

hooks = settings.setdefault('hooks', {})
event_hooks = hooks.setdefault('$event', [])

# Check if already installed
new_cmd = '$cmd'
for entry in event_hooks:
    for h in entry.get('hooks', []):
        if h.get('command', '') == new_cmd:
            print('Hook already installed for $event -> $profile', file=sys.stderr)
            sys.exit(0)

# Add the hook
event_hooks.append({
    'hooks': [{
        'type': 'command',
        'command': new_cmd,
        'statusMessage': 'bang: loading $profile context',
        'timeout': 30
    }]
})

with open('$settings_file', 'w') as f:
    json.dump(settings, f, indent=2)

print('Hook installed: $event -> $profile', file=sys.stderr)
" 2>&1
  fi

  echo -e "${GREEN}Installed hook: ${event} → ${profile}${NC}"
}

# ─── Uninstall Hook ──────────────────────────────────────────────
uninstall_hook() {
  local event="${1:-}"
  local profile="${2:-}"

  if [ -z "$event" ] || [ -z "$profile" ]; then
    echo -e "${RED}Usage: bang uninstall-hook <event> <profile|loader>${NC}" >&2
    exit 1
  fi

  local cmd=""
  if [ -f "$PROFILES_DIR/${profile}.sh" ]; then
    cmd="$BANG_DIR/profiles/${profile}.sh"
  elif [ -f "$LOADERS_DIR/${profile}.sh" ]; then
    cmd="$BANG_DIR/loaders/${profile}.sh"
  else
    echo -e "${RED}Error: '${profile}' not found${NC}" >&2
    exit 1
  fi

  local settings_file="$HOME/.claude/settings.json"

  # Use jq to safely modify JSON (with python3 fallback)
  if command -v jq &>/dev/null; then
    # Remove the hook using jq
    jq --arg event "$event" --arg cmd "$cmd" '
      .hooks[$event] |= map(
        .hooks |= map(select(.command != $cmd))
        | select(.hooks | length > 0)
      )
    ' "$settings_file" > "${settings_file}.tmp" && mv "${settings_file}.tmp" "$settings_file"
  else
    # Python3 fallback
    python3 -c "
import json

with open('$settings_file') as f:
    settings = json.load(f)

hooks = settings.get('hooks', {})
event_hooks = hooks.get('$event', [])

# Filter out matching hooks
new_event_hooks = []
removed = False
for entry in event_hooks:
    keep = True
    for h in entry.get('hooks', []):
        if h.get('command', '') == '$cmd':
            keep = False
            removed = True
    if keep:
        new_event_hooks.append(entry)

if removed:
    hooks['$event'] = new_event_hooks
    with open('$settings_file', 'w') as f:
        json.dump(settings, f, indent=2)
    print('Removed')
else:
    print('NotFound')
" 2>/dev/null
  fi

  echo -e "${GREEN}Uninstalled hook: ${event} → ${profile}${NC}"
}

